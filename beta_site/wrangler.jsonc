{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "neurodata-audit-researcher-beta",
  "main": "src/index.js",
  "compatibility_date": "2026-09-03",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "public",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "neurodata-researcher-beta-installs",
      "database_id": "9bf1a170-99f7-42bc-b8ab-f5bc89fe9101",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["17 3 * * *"]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": false
    }
  }
}
